# App
NEXT_PUBLIC_APP_NAME="AEO Engine"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string. For Supabase: Project Settings → Database →
# Connection string → "Transaction" pooler (port 6543) — required for
# serverless (Vercel functions, the /api/cron/run-due endpoint); a direct
# connection (port 5432) also works for local dev / the standalone worker.
DATABASE_URL=

# Auth.js — required even for local dev (no auto-generated dev secret on this
# version). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Optional. Without it, sign-in falls back to the "Dev sign-in" credentials
# provider on /login (local only — refuses to issue a session once NODE_ENV=production).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Reserved — email magic link isn't wired up yet (needs a DB session adapter); see README.
EMAIL_SERVER=
EMAIL_FROM=
ADMIN_EMAILS=
CRON_SECRET=

# LLM providers — all optional; missing ones are skipped; none = mock mode
OPENROUTER_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
LLM_MOCK_MODE=false          # force mock even if keys exist

# Models (override defaults in src/engine/config.ts).
# Defaults were current as of Oct 2026 — provider APIs move fast, so verify
# before relying on them for anything billed:
#   - OpenRouter: https://openrouter.ai/models (chatgpt/claude slugs route through OpenRouter)
#   - Gemini: https://ai.google.dev/gemini-api/docs (now served via the Interactions API)
#   - Perplexity: https://docs.perplexity.ai (Sonar Chat Completions is in legacy winddown; Agent API is the forward path)
MODEL_CHATGPT=
MODEL_CLAUDE=
MODEL_GEMINI=
MODEL_PERPLEXITY=
MODEL_UTILITY=               # cheapest model for extraction/generation

# Features
ENABLE_LLM_EXTRACTION=true
GOOGLE_PLACES_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CHECKER_DAILY_USD_CAP=2
CHECKER_PER_IP_PER_DAY=3

# Engine tuning
PROVIDER_CONCURRENCY=4
